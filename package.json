{
  "name": "mobile-client",
  "version": "1.0.0",
  "scripts": {
    "start": "yarn with-env expo start",
    "android": "yarn with-env expo start --android",
    "ios": "yarn with-env expo start --ios",
    "web": "yarn with-env expo start --web",
    "deploy:ios": "./lint.sh && rm -rf build-*.ipa && cp credentials.json.dev credentials.json && yarn with-env-prod eas build -p ios --profile local-production --local && ./deploy.sh",
    "deploy:android": "./lint.sh && cp credentials.json.dev credentials.json && yarn with-env-prod eas build -p android --profile local-production --local",
    "deploy-stg:ios": "./lint.sh && rm -rf build-*.ipa && cp credentials.json.stg credentials.json && yarn with-env-stg eas build -p ios --profile local-production --local && ./deploy.sh",
    "deploy-stg:android": "./lint.sh && cp credentials.json.stg credentials.json && yarn with-env-stg eas build -p android --profile local-production --local",
    "build-ios:dev": "./lint.sh && rm -rf build-*.ipa && yarn with-env eas build -p ios --profile development --local",
    "build-android:dev": "./lint.sh && rm -rf build-*.apk && yarn with-env eas build -p android --profile development --local",
    "test": "jest --watchAll",
    "with-env": "dotenv -e .env --",
    "with-env-prod": "dotenv -e .env.production --",
    "with-env-stg": "dotenv -e .env.staging --",
    "schema:codegen": "gqlg --schemaFilePath ./schema/schema.graphql --destDirPath ./__generated__ --depthLimit 3 && prettier --write --loglevel silent __generated__/**/*.gql",
    "codegen": "yarn with-env graphql-codegen --config graphql-codegen/codegen.ts && yarn schema:codegen",
    "typegen": "graphql-codegen --config graphql-codegen/typegen.yml && eslint src/graphql --fix",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx && npx tsc --noEmit",
    "increment:versioncode": "json-version-inc -j ./app.version.json -p version.android.versionCode -t PATCH && git add app.version.json && git commit --amend --no-edit",
    "increment:buildnumber": "json-version-inc -j ./app.version.json -p version.ios.buildNumber -t PATCH && git add app.version.json && git commit --amend --no-edit",
    "postinstall": "patch-package",
    "eas-build-on-success": "npx bugsnag-eas-build-on-success",
    "prepare": "husky install"
  },
  "pre-push": [
    "increment:versioncode",
    "increment:buildnumber"
  ],
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@apollo/client": "^3.7.11",
    "@bugsnag/expo": "^48.1.0",
    "@expo/config-plugins": "~7.2.2",
    "@expo/vector-icons": "^13.0.0",
    "@hookform/resolvers": "^3.0.0",
    "@react-native-async-storage/async-storage": "1.18.2",
    "@react-native-community/netinfo": "9.3.10",
    "@react-navigation/material-top-tabs": "^6.6.2",
    "@react-navigation/native": "^6.1.6",
    "@react-navigation/stack": "^6.3.16",
    "@rneui/base": "^4.0.0-rc.7",
    "@rneui/themed": "^4.0.0-rc.7",
    "@shopify/flash-list": "1.4.3",
    "@twotalltotems/react-native-otp-input": "1.3.7",
    "axios": "^1.3.6",
    "dayjs": "^1.11.8",
    "deepmerge": "^4.3.1",
    "expo": "^49.0.13",
    "expo-apple-authentication": "~6.1.0",
    "expo-application": "~5.3.0",
    "expo-auth-session": "~5.0.2",
    "expo-av": "~13.4.1",
    "expo-clipboard": "~4.3.1",
    "expo-constants": "~14.4.2",
    "expo-crypto": "~12.4.1",
    "expo-dev-client": "~2.4.11",
    "expo-device": "~5.4.0",
    "expo-file-system": "~15.4.4",
    "expo-font": "~11.4.0",
    "expo-image-picker": "~14.3.2",
    "expo-linking": "~5.0.2",
    "expo-local-authentication": "~13.4.1",
    "expo-location": "~16.1.0",
    "expo-notifications": "~0.20.1",
    "expo-router": "^2.0.0",
    "expo-secure-store": "~12.3.1",
    "expo-splash-screen": "~0.20.5",
    "expo-status-bar": "~1.6.0",
    "expo-system-ui": "~2.4.0",
    "expo-updates": "~0.18.14",
    "expo-web-browser": "~12.3.2",
    "graphql": "^16.6.0",
    "i18next": "^22.4.15",
    "intl-pluralrules": "^2.0.0",
    "mime": "^3.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.43.9",
    "react-i18next": "^12.2.0",
    "react-native": "0.72.5",
    "react-native-flash-message": "^0.4.1",
    "react-native-gesture-handler": "~2.12.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-maps": "1.7.1",
    "react-native-mask-input": "^1.2.3",
    "react-native-modal": "^13.0.1",
    "react-native-pager-view": "6.2.0",
    "react-native-reanimated": "~3.3.0",
    "react-native-reanimated-carousel": "^3.4.0",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "4.6.3",
    "react-native-screens": "~3.22.0",
    "react-native-svg": "13.9.0",
    "react-native-tab-view": "^3.5.1",
    "react-native-web": "~0.19.6",
    "react-number-format": "^5.2.2",
    "react-query": "^3.39.3",
    "subscriptions-transport-ws": "^0.11.0",
    "twrnc": "^3.6.0",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@bugsnag/plugin-expo-eas-sourcemaps": "^48.1.0",
    "@bugsnag/source-maps": "^2.3.1",
    "@graphql-codegen/cli": "^3.2.2",
    "@graphql-codegen/client-preset": "^2.1.1",
    "@graphql-codegen/fragment-matcher": "^4.0.1",
    "@graphql-codegen/introspection": "^3.0.1",
    "@graphql-codegen/near-operation-file-preset": "^2.5.0",
    "@graphql-codegen/schema-ast": "^3.0.1",
    "@graphql-codegen/typescript-react-apollo": "^3.3.7",
    "@react-native-community/eslint-config": "^3.2.0",
    "@types/mime": "^3.0.1",
    "@types/react": "~18.2.14",
    "@typescript-eslint/eslint-plugin": "^5.57.0",
    "@typescript-eslint/parser": "^5.57.0",
    "babel-plugin-transform-inline-environment-variables": "^0.4.4",
    "dotenv-cli": "^7.2.1",
    "eslint": "^8.37.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.0.0",
    "gql-generator": "^1.0.19",
    "husky": "^8.0.0",
    "jest": "^29.2.1",
    "jest-expo": "~48.0.0",
    "json-version-inc": "^1.1.0",
    "patch-package": "^6.5.1",
    "pre-push": "^0.1.4",
    "prettier": "^2.8.7",
    "react-native-svg-transformer": "^1.0.0",
    "react-test-renderer": "18.2.0",
    "tailwindcss": "^3.3.1",
    "typescript": "^5.1.3"
  },
  "private": true
}